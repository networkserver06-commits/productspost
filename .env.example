# Lee Tech server configuration
# Generate a strong JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=production
APP_URL=https://post.leetec.online
PUBLIC_SITE_BASE_URL=https://post.leetec.online
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Admin access. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<minimum-12-character-password>
# ADMIN_PASSWORD_HASH=<salt>:<64-byte-scrypt-hash-hex>
JWT_SECRET=<unique-random-secret-at-least-32-characters>
NOTE_ENCRYPTION_KEY=<different-unique-random-secret-at-least-32-characters>

# Exact browser origins, comma-separated, without trailing slashes.
CORS_ORIGINS=https://post.leetec.online,https://www.post.leetec.online

# Paystack server-side configuration. Never expose the secret key to the browser.
PAYSTACK_SECRET_KEY=sk_test_<your-paystack-secret-key>
PAYSTACK_PUBLIC_KEY=pk_test_<your-paystack-public-key>
# Paystack signs webhook payloads with the secret key; keep this alias for deployment documentation.
PAYSTACK_WEBHOOK_SECRET=<same-secret-or-managed-webhook-secret>
PAYSTACK_CURRENCY=KES
# Optional; defaults to https://post.leetec.online/?payment=complete via PUBLIC_SITE_BASE_URL.
PAYSTACK_CALLBACK_URL=https://post.leetec.online/?payment=complete
# Leave empty to let Paystack Checkout show the channels enabled for the account.
# Example: card,mobile_money
PAYSTACK_CHANNELS=

# Posting and email configuration.
POST_PRICE_KES=0
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_FROM_EMAIL=Lee Tech <noreply@updates.leetec.online>

WHATSAPP_NUMBER=254700000000
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/<invite-code>
